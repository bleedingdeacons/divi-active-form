{
  "name": "divi-active-form/form-field",
  "d4Shortcode": "",
  "title": "Form Field",
  "titles": "Form Fields",
  "description": "One field of a Register Form.",
  "keywords": [
    "form field",
    "input",
    "dropdown",
    "json"
  ],
  "category": "child-module",
  "childrenName": [],
  "attributes": {
    "module": {
      "type": "object",
      "selector": "{{selector}}",
      "settings": {
        "meta": {
          "adminLabel": []
        },
        "advanced": {
          "html": []
        },
        "decoration": {
          "attributes": [],
          "conditions": [],
          "disabledOn": [],
          "sizing": [],
          "spacing": []
        }
      }
    },
    "fieldItem": {
      "type": "object",
      "default": {
        "innerContent": {
          "desktop": {
            "value": "Field"
          }
        },
        "advanced": {
          "type": {
            "desktop": {
              "value": "text"
            }
          },
          "required": {
            "desktop": {
              "value": "off"
            }
          },
          "fullwidth": {
            "desktop": {
              "value": "on"
            }
          }
        }
      },
      "settings": {
        "innerContent": {
          "groupType": "group-item",
          "item": {
            "groupSlug": "contentField",
            "attrName": "fieldItem.innerContent",
            "label": "Label",
            "description": "The field's label, shown above it.",
            "priority": 5,
            "render": true,
            "features": {
              "hover": false,
              "sticky": false,
              "responsive": false,
              "preset": "content"
            },
            "component": {
              "type": "field",
              "name": "divi/text"
            }
          }
        },
        "advanced": {
          "name": {
            "groupType": "group-item",
            "item": {
              "groupSlug": "contentField",
              "attrName": "fieldItem.advanced.name",
              "label": "Field Name",
              "description": "The post meta / ACF field the value is saved to, e.g. group or email. Leave blank to derive it from the label.",
              "priority": 10,
              "render": true,
              "features": {
                "hover": false,
                "sticky": false,
                "responsive": false,
                "preset": "content"
              },
              "component": {
                "type": "field",
                "name": "divi/text"
              }
            }
          },
          "type": {
            "groupType": "group-item",
            "item": {
              "groupSlug": "contentField",
              "attrName": "fieldItem.advanced.type",
              "label": "Type",
              "description": "What kind of input this is. A JSON Dropdown takes its options from the JSON Source below.",
              "priority": 20,
              "render": true,
              "features": {
                "hover": false,
                "sticky": false,
                "responsive": false,
                "preset": "content"
              },
              "component": {
                "type": "field",
                "name": "divi/select",
                "props": {
                  "options": {
                    "text": {
                      "label": "Text"
                    },
                    "email": {
                      "label": "Email"
                    },
                    "tel": {
                      "label": "Phone"
                    },
                    "textarea": {
                      "label": "Paragraph"
                    },
                    "select": {
                      "label": "Dropdown"
                    },
                    "json": {
                      "label": "JSON Dropdown"
                    },
                    "checkbox": {
                      "label": "Checkbox"
                    }
                  }
                }
              }
            }
          },
          "required": {
            "groupType": "group-item",
            "item": {
              "groupSlug": "contentField",
              "attrName": "fieldItem.advanced.required",
              "label": "Required",
              "description": "The form cannot be sent with this field empty.",
              "priority": 30,
              "render": true,
              "features": {
                "hover": false,
                "sticky": false,
                "responsive": false,
                "preset": "content"
              },
              "component": {
                "type": "field",
                "name": "divi/toggle"
              }
            }
          },
          "placeholder": {
            "groupType": "group-item",
            "item": {
              "groupSlug": "contentField",
              "attrName": "fieldItem.advanced.placeholder",
              "label": "Placeholder",
              "description": "Hint shown inside an empty text field.",
              "priority": 40,
              "render": true,
              "features": {
                "hover": false,
                "sticky": false,
                "responsive": false,
                "preset": "content"
              },
              "component": {
                "type": "field",
                "name": "divi/text"
              }
            }
          },
          "fullwidth": {
            "groupType": "group-item",
            "item": {
              "groupSlug": "contentField",
              "attrName": "fieldItem.advanced.fullwidth",
              "label": "Full Width",
              "description": "Off puts this field in a half-width column beside the next half-width field.",
              "priority": 50,
              "render": true,
              "features": {
                "hover": false,
                "sticky": false,
                "responsive": false,
                "preset": "content"
              },
              "component": {
                "type": "field",
                "name": "divi/toggle"
              }
            }
          },
          "emptyLabel": {
            "groupType": "group-item",
            "item": {
              "groupSlug": "contentOptions",
              "attrName": "fieldItem.advanced.emptyLabel",
              "label": "First Option Text",
              "description": "Dropdowns: the leading 'nothing chosen' option, e.g. Choose your group.",
              "priority": 10,
              "render": true,
              "features": {
                "hover": false,
                "sticky": false,
                "responsive": false,
                "preset": "content"
              },
              "component": {
                "type": "field",
                "name": "divi/text"
              }
            }
          },
          "options": {
            "groupType": "group-item",
            "item": {
              "groupSlug": "contentOptions",
              "attrName": "fieldItem.advanced.options",
              "label": "Options",
              "description": "Dropdown only: one option per line, as value|label, or just a label.",
              "priority": 20,
              "render": true,
              "features": {
                "hover": false,
                "sticky": false,
                "responsive": false,
                "preset": "content"
              },
              "component": {
                "type": "field",
                "name": "divi/textarea"
              }
            }
          },
          "source": {
            "groupType": "group-item",
            "item": {
              "groupSlug": "contentOptions",
              "attrName": "fieldItem.advanced.source",
              "label": "JSON Source",
              "description": "JSON Dropdown only: a URL or site path returning JSON. For 12 Step Meeting List groups use /wp-json/divi-active-form/v1/groups.",
              "priority": 30,
              "render": true,
              "features": {
                "hover": false,
                "sticky": false,
                "responsive": false,
                "preset": "content"
              },
              "component": {
                "type": "field",
                "name": "divi/text"
              }
            }
          },
          "itemsPath": {
            "groupType": "group-item",
            "item": {
              "groupSlug": "contentOptions",
              "attrName": "fieldItem.advanced.itemsPath",
              "label": "Items Path",
              "description": "JSON Dropdown: dot path to the list inside the JSON, e.g. data.items. Leave blank when the JSON is the list.",
              "priority": 40,
              "render": true,
              "features": {
                "hover": false,
                "sticky": false,
                "responsive": false,
                "preset": "content"
              },
              "component": {
                "type": "field",
                "name": "divi/text"
              }
            }
          },
          "valueKey": {
            "groupType": "group-item",
            "item": {
              "groupSlug": "contentOptions",
              "attrName": "fieldItem.advanced.valueKey",
              "label": "Value Key",
              "description": "JSON Dropdown: key (or dot path) of each item's value. Default: value, falling back to id.",
              "priority": 50,
              "render": true,
              "features": {
                "hover": false,
                "sticky": false,
                "responsive": false,
                "preset": "content"
              },
              "component": {
                "type": "field",
                "name": "divi/text"
              }
            }
          },
          "labelKey": {
            "groupType": "group-item",
            "item": {
              "groupSlug": "contentOptions",
              "attrName": "fieldItem.advanced.labelKey",
              "label": "Label Key",
              "description": "JSON Dropdown: key (or dot path) of each item's label. Default: label, falling back to name or title.rendered.",
              "priority": 60,
              "render": true,
              "features": {
                "hover": false,
                "sticky": false,
                "responsive": false,
                "preset": "content"
              },
              "component": {
                "type": "field",
                "name": "divi/text"
              }
            }
          }
        }
      }
    }
  },
  "customCssFields": {},
  "settings": {
    "content": "auto",
    "design": "auto",
    "advanced": "auto",
    "groups": {
      "contentField": {
        "panel": "content",
        "priority": 10,
        "groupName": "contentField",
        "component": {
          "name": "divi/composite",
          "props": {
            "groupLabel": "Field"
          }
        }
      },
      "contentOptions": {
        "panel": "content",
        "priority": 20,
        "groupName": "contentOptions",
        "component": {
          "name": "divi/composite",
          "props": {
            "groupLabel": "Dropdown Options"
          }
        }
      }
    }
  }
}
