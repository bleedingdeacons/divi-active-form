{
  "name": "divi-active-form/form-field",
  "d4Shortcode": "",
  "title": "Form Field",
  "titles": "Form Fields",
  "description": "One field of a Divi Active Form.",
  "keywords": [
    "form field",
    "input",
    "dropdown",
    "json"
  ],
  "category": "child-module",
  "childrenName": [],
  "attributes": {
    "module": {
      "type": "object",
      "selector": "{{selector}}",
      "settings": {
        "meta": {
          "adminLabel": []
        },
        "advanced": {
          "html": []
        },
        "decoration": {
          "attributes": [],
          "conditions": [],
          "disabledOn": [],
          "sizing": [],
          "spacing": []
        }
      }
    },
    "fieldItem": {
      "type": "object",
      "default": {
        "innerContent": {
          "desktop": {
            "value": "Field"
          }
        },
        "advanced": {
          "type": {
            "desktop": {
              "value": "text"
            }
          },
          "required": {
            "desktop": {
              "value": "off"
            }
          },
          "options": {
            "desktop": {
              "value": "small|Small\nmedium|Medium\nlarge|Large"
            }
          },
          "source": {
            "desktop": {
              "value": "/wp-json/divi-active-form/v1/example-options"
            }
          },
          "visibleMatch": {
            "desktop": {
              "value": "all"
            }
          },
          "enabledMatch": {
            "desktop": {
              "value": "all"
            }
          },
          "width": {
            "desktop": {
              "value": "100"
            }
          },
          "labelPosition": {
            "desktop": {
              "value": "top"
            }
          }
        }
      },
      "settings": {
        "innerContent": {
          "groupType": "group-item",
          "item": {
            "groupSlug": "contentField",
            "attrName": "fieldItem.innerContent",
            "label": "Label",
            "description": "The field's label, shown above it.",
            "priority": 5,
            "render": true,
            "features": {
              "hover": false,
              "sticky": false,
              "responsive": false,
              "preset": "content"
            },
            "component": {
              "type": "field",
              "name": "divi/text"
            }
          }
        },
        "advanced": {
          "name": {
            "groupType": "group-item",
            "item": {
              "groupSlug": "contentField",
              "attrName": "fieldItem.advanced.name",
              "label": "Field Name",
              "description": "The post meta / ACF field the value is saved to, e.g. size or email. Leave blank to derive it from the label.",
              "priority": 10,
              "render": true,
              "features": {
                "hover": false,
                "sticky": false,
                "responsive": false,
                "preset": "content"
              },
              "component": {
                "type": "field",
                "name": "divi/text"
              }
            }
          },
          "type": {
            "groupType": "group-item",
            "item": {
              "groupSlug": "contentField",
              "attrName": "fieldItem.advanced.type",
              "label": "Type",
              "description": "What kind of input this is. A JSON Dropdown takes its options from the JSON Source below; an ACF Dropdown lists the values of a field across the posts of a post type.",
              "priority": 20,
              "render": true,
              "features": {
                "hover": false,
                "sticky": false,
                "responsive": false,
                "preset": "content"
              },
              "component": {
                "type": "field",
                "name": "divi/select",
                "props": {
                  "options": {
                    "text": {
                      "label": "Text"
                    },
                    "email": {
                      "label": "Email"
                    },
                    "tel": {
                      "label": "Phone"
                    },
                    "textarea": {
                      "label": "Paragraph"
                    },
                    "select": {
                      "label": "Dropdown"
                    },
                    "json": {
                      "label": "JSON Dropdown"
                    },
                    "acf": {
                      "label": "ACF Dropdown"
                    },
                    "checkbox": {
                      "label": "Checkbox"
                    }
                  }
                }
              }
            }
          },
          "required": {
            "groupType": "group-item",
            "item": {
              "groupSlug": "contentField",
              "attrName": "fieldItem.advanced.required",
              "label": "Required",
              "description": "The form cannot be sent with this field empty.",
              "priority": 30,
              "render": true,
              "features": {
                "hover": false,
                "sticky": false,
                "responsive": false,
                "preset": "content"
              },
              "component": {
                "type": "field",
                "name": "divi/toggle"
              }
            }
          },
          "placeholder": {
            "groupType": "group-item",
            "item": {
              "groupSlug": "contentField",
              "attrName": "fieldItem.advanced.placeholder",
              "label": "Placeholder",
              "description": "Hint shown in the empty field. Text, Email, Phone and Paragraph fields show it greyed inside the box; a Dropdown or JSON Dropdown shows it as its first, 'nothing chosen' option unless First Option Text is set. A Checkbox has no placeholder.",
              "priority": 40,
              "render": true,
              "features": {
                "hover": false,
                "sticky": false,
                "responsive": false,
                "preset": "content"
              },
              "component": {
                "type": "field",
                "name": "divi/text"
              }
            }
          },
          "emptyLabel": {
            "groupType": "group-item",
            "item": {
              "groupSlug": "contentOptions",
              "attrName": "fieldItem.advanced.emptyLabel",
              "label": "First Option Text",
              "description": "Dropdowns: the leading 'nothing chosen' option, e.g. Choose a size. Leave blank to use the Placeholder, or 'Choose an option' when that is blank too.",
              "priority": 10,
              "render": true,
              "features": {
                "hover": false,
                "sticky": false,
                "responsive": false,
                "preset": "content"
              },
              "component": {
                "type": "field",
                "name": "divi/text"
              }
            }
          },
          "options": {
            "groupType": "group-item",
            "item": {
              "groupSlug": "contentOptions",
              "attrName": "fieldItem.advanced.options",
              "label": "Options",
              "description": "Dropdown only: one option per line, as value|label, or just a label. Example: small|Small, medium|Medium, large|Large, each on its own line.",
              "priority": 20,
              "render": true,
              "features": {
                "hover": false,
                "sticky": false,
                "responsive": false,
                "preset": "content"
              },
              "component": {
                "type": "field",
                "name": "divi/textarea"
              }
            }
          },
          "source": {
            "groupType": "group-item",
            "item": {
              "groupSlug": "contentOptions",
              "attrName": "fieldItem.advanced.source",
              "label": "JSON Source",
              "description": "JSON Dropdown only: a URL or site path returning JSON. The default, /wp-json/divi-active-form/v1/example-options, is a sample list; add ?shape=nested for a nested version (Items Path data.items, Value Key code, Label Key name). /wp-json/wp/v2/categories lists this site's post categories.",
              "priority": 30,
              "render": true,
              "features": {
                "hover": false,
                "sticky": false,
                "responsive": false,
                "preset": "content"
              },
              "component": {
                "type": "field",
                "name": "divi/text"
              }
            }
          },
          "itemsPath": {
            "groupType": "group-item",
            "item": {
              "groupSlug": "contentOptions",
              "attrName": "fieldItem.advanced.itemsPath",
              "label": "Items Path",
              "description": "JSON Dropdown: dot path to the list inside the JSON. Example: data.items for {\"data\": {\"items\": [...]}}. Leave blank when the JSON is the list.",
              "priority": 40,
              "render": true,
              "features": {
                "hover": false,
                "sticky": false,
                "responsive": false,
                "preset": "content"
              },
              "component": {
                "type": "field",
                "name": "divi/text"
              }
            }
          },
          "valueKey": {
            "groupType": "group-item",
            "item": {
              "groupSlug": "contentOptions",
              "attrName": "fieldItem.advanced.valueKey",
              "label": "Value Key",
              "description": "JSON Dropdown: key (or dot path) of each item's value. Example: id. Leave blank to try value, id, ID, then slug.",
              "priority": 50,
              "render": true,
              "features": {
                "hover": false,
                "sticky": false,
                "responsive": false,
                "preset": "content"
              },
              "component": {
                "type": "field",
                "name": "divi/text"
              }
            }
          },
          "labelKey": {
            "groupType": "group-item",
            "item": {
              "groupSlug": "contentOptions",
              "attrName": "fieldItem.advanced.labelKey",
              "label": "Label Key",
              "description": "JSON Dropdown: key (or dot path) of each item's label. Example: name or title.rendered. Leave blank to try label, name, title.rendered, then title.",
              "priority": 60,
              "render": true,
              "features": {
                "hover": false,
                "sticky": false,
                "responsive": false,
                "preset": "content"
              },
              "component": {
                "type": "field",
                "name": "divi/text"
              }
            }
          },
          "visibleRules": {
            "groupType": "group-item",
            "item": {
              "groupSlug": "contentConditions",
              "attrName": "fieldItem.advanced.visibleRules",
              "label": "Show When",
              "description": "Show this field only when these rules hold; otherwise it is hidden, not required, and not saved. Add a rule, pick another field in this form, a condition and (for equals / does not equal) a value. No rules means always.",
              "priority": 10,
              "render": true,
              "features": {
                "hover": false,
                "sticky": false,
                "responsive": false,
                "preset": "content"
              },
              "component": {
                "type": "field",
                "name": "divi-active-form/condition-rules"
              }
            }
          },
          "visibleMatch": {
            "groupType": "group-item",
            "item": {
              "groupSlug": "contentConditions",
              "attrName": "fieldItem.advanced.visibleMatch",
              "label": "Show When Matches",
              "description": "Whether every Show When rule must hold, or any one of them.",
              "priority": 20,
              "render": true,
              "features": {
                "hover": false,
                "sticky": false,
                "responsive": false,
                "preset": "content"
              },
              "component": {
                "type": "field",
                "name": "divi/select",
                "props": {
                  "options": {
                    "all": {
                      "label": "All rules"
                    },
                    "any": {
                      "label": "Any rule"
                    }
                  }
                }
              }
            }
          },
          "enabledRules": {
            "groupType": "group-item",
            "item": {
              "groupSlug": "contentConditions",
              "attrName": "fieldItem.advanced.enabledRules",
              "label": "Enable When",
              "description": "Let visitors fill in this field only when these rules hold; otherwise it is shown greyed out, not required, and not saved. Add a rule, pick another field in this form, a condition and (for equals / does not equal) a value. No rules means always.",
              "priority": 30,
              "render": true,
              "features": {
                "hover": false,
                "sticky": false,
                "responsive": false,
                "preset": "content"
              },
              "component": {
                "type": "field",
                "name": "divi-active-form/condition-rules"
              }
            }
          },
          "enabledMatch": {
            "groupType": "group-item",
            "item": {
              "groupSlug": "contentConditions",
              "attrName": "fieldItem.advanced.enabledMatch",
              "label": "Enable When Matches",
              "description": "Whether every Enable When rule must hold, or any one of them.",
              "priority": 40,
              "render": true,
              "features": {
                "hover": false,
                "sticky": false,
                "responsive": false,
                "preset": "content"
              },
              "component": {
                "type": "field",
                "name": "divi/select",
                "props": {
                  "options": {
                    "all": {
                      "label": "All rules"
                    },
                    "any": {
                      "label": "Any rule"
                    }
                  }
                }
              }
            }
          },
          "labelPosition": {
            "groupType": "group-item",
            "item": {
              "groupSlug": "contentField",
              "attrName": "fieldItem.advanced.labelPosition",
              "label": "Label Position",
              "description": "Where the label sits: above the field, to its left, below it, or hidden. A hidden label is still read out by screen readers, so give the field a Placeholder to show what it is for.",
              "priority": 45,
              "render": true,
              "features": {
                "hover": false,
                "sticky": false,
                "responsive": false,
                "preset": "content"
              },
              "component": {
                "type": "field",
                "name": "divi/select",
                "props": {
                  "options": {
                    "top": {
                      "label": "Top"
                    },
                    "left": {
                      "label": "Left"
                    },
                    "below": {
                      "label": "Below"
                    },
                    "hidden": {
                      "label": "Hidden"
                    }
                  }
                }
              }
            }
          },
          "width": {
            "groupType": "group-item",
            "item": {
              "groupSlug": "contentField",
              "attrName": "fieldItem.advanced.width",
              "label": "Width",
              "description": "How much of the form row the field takes. Narrower fields sit side by side, e.g. a half next to a half, or three quarters next to a quarter. On phones every field is full width.",
              "priority": 50,
              "render": true,
              "features": {
                "hover": false,
                "sticky": false,
                "responsive": false,
                "preset": "content"
              },
              "component": {
                "type": "field",
                "name": "divi/select",
                "props": {
                  "options": {
                    "100": {
                      "label": "Full"
                    },
                    "75": {
                      "label": "Three Quarters"
                    },
                    "50": {
                      "label": "Half"
                    },
                    "25": {
                      "label": "Quarter"
                    }
                  }
                }
              }
            }
          },
          "acfPostType": {
            "groupType": "group-item",
            "item": {
              "groupSlug": "contentOptions",
              "attrName": "fieldItem.advanced.acfPostType",
              "label": "ACF Post Type",
              "description": "ACF Dropdown only: the post type whose published posts are read. ▾ lists the site's post types.",
              "priority": 70,
              "render": true,
              "features": {
                "hover": false,
                "sticky": false,
                "responsive": false,
                "preset": "content"
              },
              "component": {
                "type": "field",
                "name": "divi-active-form/post-type"
              }
            }
          },
          "acfField": {
            "groupType": "group-item",
            "item": {
              "groupSlug": "contentOptions",
              "attrName": "fieldItem.advanced.acfField",
              "label": "ACF Field",
              "description": "ACF Dropdown only: the field whose values become the options, by field name. ▾ lists the site's ACF fields; plain post meta keys can be typed too. Each distinct value appears once, and the value is what is saved.",
              "priority": 80,
              "render": true,
              "features": {
                "hover": false,
                "sticky": false,
                "responsive": false,
                "preset": "content"
              },
              "component": {
                "type": "field",
                "name": "divi-active-form/acf-field"
              }
            }
          }
        }
      }
    },
    "hint": {
      "type": "object",
      "selector": "{{selector}} .daf-field__hint",
      "default": {
        "advanced": {
          "position": {
            "desktop": {
              "value": "below"
            }
          }
        }
      },
      "settings": {
        "advanced": {
          "text": {
            "groupType": "group-item",
            "item": {
              "groupSlug": "contentHint",
              "attrName": "hint.advanced.text",
              "label": "Hint",
              "description": "Helper text shown with the field, e.g. \"We only use this to reply to you.\" Screen readers read it with the field. Leave blank for none.",
              "priority": 10,
              "render": true,
              "features": {
                "hover": false,
                "sticky": false,
                "responsive": false,
                "preset": "content"
              },
              "component": {
                "type": "field",
                "name": "divi/textarea"
              }
            }
          },
          "position": {
            "groupType": "group-item",
            "item": {
              "groupSlug": "contentHint",
              "attrName": "hint.advanced.position",
              "label": "Hint Position",
              "description": "Show the hint above the field or under it.",
              "priority": 20,
              "render": true,
              "features": {
                "hover": false,
                "sticky": false,
                "responsive": false,
                "preset": "content"
              },
              "component": {
                "type": "field",
                "name": "divi/select",
                "props": {
                  "options": {
                    "below": {
                      "label": "Below"
                    },
                    "above": {
                      "label": "Above"
                    }
                  }
                }
              }
            }
          },
          "color": {
            "groupType": "group-item",
            "item": {
              "groupSlug": "contentHint",
              "attrName": "hint.advanced.color",
              "label": "Hint Colour",
              "description": "Colour of the hint text. Leave unset for grey.",
              "priority": 30,
              "render": true,
              "features": {
                "hover": false,
                "sticky": false,
                "responsive": false,
                "preset": "content"
              },
              "component": {
                "type": "field",
                "name": "divi/color-picker"
              }
            }
          }
        }
      }
    }
  },
  "customCssFields": {
    "hint": {
      "label": "Hint",
      "subName": "hint",
      "selectorSuffix": " .daf-field__hint"
    }
  },
  "settings": {
    "content": "auto",
    "design": "auto",
    "advanced": "auto",
    "groups": {
      "contentField": {
        "panel": "content",
        "priority": 10,
        "groupName": "contentField",
        "component": {
          "name": "divi/composite",
          "props": {
            "groupLabel": "Field"
          }
        }
      },
      "contentOptions": {
        "panel": "content",
        "priority": 20,
        "groupName": "contentOptions",
        "component": {
          "name": "divi/composite",
          "props": {
            "groupLabel": "Dropdown Options"
          }
        }
      },
      "contentConditions": {
        "panel": "content",
        "priority": 30,
        "groupName": "contentConditions",
        "component": {
          "name": "divi/composite",
          "props": {
            "groupLabel": "Conditional Logic"
          }
        }
      },
      "contentHint": {
        "panel": "content",
        "priority": 15,
        "groupName": "contentHint",
        "component": {
          "name": "divi/composite",
          "props": {
            "groupLabel": "Hint"
          }
        }
      }
    }
  }
}
