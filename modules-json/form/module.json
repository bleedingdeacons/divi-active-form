{
  "name": "divi-active-form/form",
  "d4Shortcode": "",
  "title": "Divi Active Form",
  "titles": "Divi Active Forms",
  "description": "A form whose submissions create posts, with dropdowns that can be filled from JSON.",
  "keywords": [
    "form",
    "post form",
    "submission",
    "json",
    "dropdown"
  ],
  "moduleIcon": "divi/module-contact-form",
  "category": "module",
  "childModuleName": "divi-active-form/form-field",
  "childModuleTitle": "Field",
  "childModuleTitleAttribute": "fieldItem",
  "childrenName": [
    "divi-active-form/form-field"
  ],
  "attributes": {
    "module": {
      "type": "object",
      "selector": "{{selector}}",
      "settings": {
        "meta": {
          "adminLabel": []
        },
        "advanced": {
          "html": [],
          "text": {
            "priority": 10
          }
        },
        "decoration": {
          "animation": [],
          "attributes": [],
          "background": [],
          "border": [],
          "boxShadow": [],
          "conditions": [],
          "disabledOn": [],
          "filters": [],
          "interactions": [],
          "overflow": [],
          "order": [],
          "position": [],
          "scroll": [],
          "sizing": [],
          "spacing": [],
          "sticky": [],
          "transform": [],
          "transition": [],
          "zIndex": []
        }
      }
    },
    "form": {
      "type": "object",
      "default": {
        "advanced": {
          "submitLabel": {
            "desktop": {
              "value": "Submit"
            }
          },
          "formId": {
            "desktop": {
              "value": "active-form"
            }
          },
          "postType": {
            "desktop": {
              "value": "post"
            }
          },
          "postStatus": {
            "desktop": {
              "value": "pending"
            }
          },
          "legacyHook": {
            "desktop": {
              "value": "off"
            }
          }
        }
      },
      "settings": {
        "advanced": {
          "title": {
            "groupType": "group-item",
            "item": {
              "groupSlug": "contentForm",
              "attrName": "form.advanced.title",
              "label": "Title",
              "description": "Heading shown above the form. Leave blank for none.",
              "priority": 10,
              "render": true,
              "features": {
                "hover": false,
                "sticky": false,
                "responsive": false,
                "preset": "content"
              },
              "component": {
                "type": "field",
                "name": "divi/text"
              }
            }
          },
          "submitLabel": {
            "groupType": "group-item",
            "item": {
              "groupSlug": "contentForm",
              "attrName": "form.advanced.submitLabel",
              "label": "Button Text",
              "description": "Text on the submit button.",
              "priority": 20,
              "render": true,
              "features": {
                "hover": false,
                "sticky": false,
                "responsive": false,
                "preset": "content"
              },
              "component": {
                "type": "field",
                "name": "divi/text"
              }
            }
          },
          "successMessage": {
            "groupType": "group-item",
            "item": {
              "groupSlug": "contentForm",
              "attrName": "form.advanced.successMessage",
              "label": "Success Message",
              "description": "Shown after a successful submission. Leave blank for the default.",
              "priority": 30,
              "render": true,
              "features": {
                "hover": false,
                "sticky": false,
                "responsive": false,
                "preset": "content"
              },
              "component": {
                "type": "field",
                "name": "divi/text"
              }
            }
          },
          "redirectUrl": {
            "groupType": "group-item",
            "item": {
              "groupSlug": "contentForm",
              "attrName": "form.advanced.redirectUrl",
              "label": "Redirect URL",
              "description": "Optional. Send the visitor here after a successful submission instead of showing the message.",
              "priority": 40,
              "render": true,
              "features": {
                "hover": false,
                "sticky": false,
                "responsive": false,
                "preset": "content"
              },
              "component": {
                "type": "field",
                "name": "divi/text"
              }
            }
          },
          "formId": {
            "groupType": "group-item",
            "item": {
              "groupSlug": "contentSubmission",
              "attrName": "form.advanced.formId",
              "label": "Form ID",
              "description": "Identifies this form to the after-insert hooks, so code listening for them can tell forms apart.",
              "priority": 10,
              "render": true,
              "features": {
                "hover": false,
                "sticky": false,
                "responsive": false,
                "preset": "content"
              },
              "component": {
                "type": "field",
                "name": "divi/text"
              }
            }
          },
          "postType": {
            "groupType": "group-item",
            "item": {
              "groupSlug": "contentSubmission",
              "attrName": "form.advanced.postType",
              "label": "Post Type",
              "description": "Each submission creates a post of this type. Choose from the post types registered on this site (▾ lists them all), or type a post type's name.",
              "priority": 20,
              "render": true,
              "features": {
                "hover": false,
                "sticky": false,
                "responsive": false,
                "preset": "content"
              },
              "component": {
                "type": "field",
                "name": "divi-active-form/post-type"
              }
            }
          },
          "postStatus": {
            "groupType": "group-item",
            "item": {
              "groupSlug": "contentSubmission",
              "attrName": "form.advanced.postStatus",
              "label": "Post Status",
              "description": "Status of the created post. Pending Review keeps public submissions off the site until someone approves them.",
              "priority": 30,
              "render": true,
              "features": {
                "hover": false,
                "sticky": false,
                "responsive": false,
                "preset": "content"
              },
              "component": {
                "type": "field",
                "name": "divi/select",
                "props": {
                  "options": {
                    "publish": {
                      "label": "Published"
                    },
                    "pending": {
                      "label": "Pending Review"
                    },
                    "draft": {
                      "label": "Draft"
                    },
                    "private": {
                      "label": "Private"
                    }
                  }
                }
              }
            }
          },
          "titleTemplate": {
            "groupType": "group-item",
            "item": {
              "groupSlug": "contentSubmission",
              "attrName": "form.advanced.titleTemplate",
              "label": "Post Title",
              "description": "Title of the created post. Use {field_name} to insert a submitted value, e.g. Submission from {email}. Leave blank for an automatic title.",
              "priority": 40,
              "render": true,
              "features": {
                "hover": false,
                "sticky": false,
                "responsive": false,
                "preset": "content"
              },
              "component": {
                "type": "field",
                "name": "divi/text"
              }
            }
          },
          "legacyHook": {
            "groupType": "group-item",
            "item": {
              "groupSlug": "contentSubmission",
              "attrName": "form.advanced.legacyHook",
              "label": "Fire After-Insert Hook",
              "description": "Also fire the daf_after_insert_post action, with the form ID and the new post ID, after divi_active_form/after_insert_post. Off by default.",
              "priority": 50,
              "render": true,
              "features": {
                "hover": false,
                "sticky": false,
                "responsive": false,
                "preset": "content"
              },
              "component": {
                "type": "field",
                "name": "divi/toggle"
              }
            }
          }
        }
      }
    },
    "title": {
      "type": "object",
      "selector": "{{selector}} .daf-form__title",
      "settings": {
        "decoration": {
          "font": {
            "priority": 10,
            "component": {
              "props": {
                "groupLabel": "Title Text",
                "fieldLabel": "Title"
              }
            }
          }
        }
      }
    },
    "label": {
      "type": "object",
      "selector": "{{selector}} .daf-field__label, {{selector}} .daf-field__checkbox",
      "settings": {
        "decoration": {
          "font": {
            "priority": 20,
            "component": {
              "props": {
                "groupLabel": "Label Text",
                "fieldLabel": "Label"
              }
            }
          }
        }
      }
    },
    "field": {
      "type": "object",
      "selector": "{{selector}} .daf-field__input",
      "styleProps": {
        "background": [],
        "border": [],
        "spacing": []
      },
      "settings": {
        "decoration": {
          "font": {
            "priority": 30,
            "component": {
              "props": {
                "groupLabel": "Field Text",
                "fieldLabel": "Field"
              }
            }
          },
          "background": {
            "groupType": "group-item",
            "item": {
              "groupSlug": "designFields",
              "priority": 10,
              "render": true,
              "component": {
                "type": "group",
                "name": "divi/background",
                "props": {
                  "grouped": true
                }
              }
            }
          },
          "border": {
            "groupType": "group-item",
            "item": {
              "groupSlug": "designFields",
              "priority": 20,
              "render": true,
              "component": {
                "type": "group",
                "name": "divi/border",
                "props": {
                  "grouped": true
                }
              }
            }
          },
          "spacing": {
            "groupType": "group-item",
            "item": {
              "groupSlug": "designFields",
              "priority": 30,
              "render": true,
              "component": {
                "type": "group",
                "name": "divi/spacing",
                "props": {
                  "grouped": true
                }
              }
            }
          }
        }
      }
    },
    "button": {
      "type": "object",
      "selector": "{{selector}} .daf-form__submit",
      "styleProps": {
        "background": [],
        "border": [],
        "spacing": []
      },
      "settings": {
        "decoration": {
          "font": {
            "priority": 40,
            "component": {
              "props": {
                "groupLabel": "Button Text",
                "fieldLabel": "Button"
              }
            }
          },
          "background": {
            "groupType": "group-item",
            "item": {
              "groupSlug": "designButton",
              "priority": 10,
              "render": true,
              "component": {
                "type": "group",
                "name": "divi/background",
                "props": {
                  "grouped": true
                }
              }
            }
          },
          "border": {
            "groupType": "group-item",
            "item": {
              "groupSlug": "designButton",
              "priority": 20,
              "render": true,
              "component": {
                "type": "group",
                "name": "divi/border",
                "props": {
                  "grouped": true
                }
              }
            }
          },
          "spacing": {
            "groupType": "group-item",
            "item": {
              "groupSlug": "designButton",
              "priority": 30,
              "render": true,
              "component": {
                "type": "group",
                "name": "divi/spacing",
                "props": {
                  "grouped": true
                }
              }
            }
          }
        }
      }
    }
  },
  "customCssFields": {
    "fields": {
      "label": "Fields",
      "subName": "fields",
      "selectorSuffix": " .daf-form__fields"
    },
    "label": {
      "label": "Labels",
      "subName": "label",
      "selectorSuffix": " .daf-field__label"
    },
    "input": {
      "label": "Inputs",
      "subName": "input",
      "selectorSuffix": " .daf-field__input"
    },
    "button": {
      "label": "Button",
      "subName": "button",
      "selectorSuffix": " .daf-form__submit"
    },
    "message": {
      "label": "Message",
      "subName": "message",
      "selectorSuffix": " .daf-form__message"
    }
  },
  "settings": {
    "content": "auto",
    "design": "auto",
    "advanced": "auto",
    "groups": {
      "contentForm": {
        "panel": "content",
        "priority": 10,
        "groupName": "contentForm",
        "component": {
          "name": "divi/composite",
          "props": {
            "groupLabel": "Form"
          }
        }
      },
      "contentSubmission": {
        "panel": "content",
        "priority": 20,
        "groupName": "contentSubmission",
        "component": {
          "name": "divi/composite",
          "props": {
            "groupLabel": "Submission"
          }
        }
      },
      "designFields": {
        "panel": "design",
        "priority": 10,
        "groupName": "designFields",
        "component": {
          "name": "divi/composite",
          "props": {
            "groupLabel": "Fields",
            "clipboardCategory": "style"
          }
        }
      },
      "designButton": {
        "panel": "design",
        "priority": 20,
        "groupName": "designButton",
        "component": {
          "name": "divi/composite",
          "props": {
            "groupLabel": "Button",
            "clipboardCategory": "style"
          }
        }
      }
    }
  }
}
